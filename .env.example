# Copy to .env.local. The README's "Connect your Shopify store" says where each value comes from.

# The app
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# The tests. Quote the password if it has # or $.
SHOPIFY_STORE_PASSWORD=''
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
AI_GATEWAY_API_KEY=

# Optional: test another URL. Defaults to http://localhost:3000.
# APP_URL=
