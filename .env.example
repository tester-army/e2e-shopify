# Copy to .env.local. next dev reads it, and e2e.config.ts loads it for the test runner.

# The dev store's domain, e.g. e2e-shopify.myshopify.com.
SHOPIFY_STORE_DOMAIN=

# The Headless channel storefront's public access token: Sales channels → Headless → your storefront.
# Dev stores lock the Online Store channel, so the Storefront API needs a token.
SHOPIFY_STOREFRONT_TOKEN=

# The dev store's password: Online Store → Preferences. The tests type it. Keep the quotes if it has # or $.
SHOPIFY_STORE_PASSWORD=''

# The Dev Dashboard app's Client ID and Client secret, for the Admin API. Only the tests use them.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# The agent's model, through the Vercel AI Gateway. Only agent steps need it.
AI_GATEWAY_API_KEY=

# Optional: test another URL. Defaults to http://localhost:3000.
# APP_URL=
